{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true
  },
  "include": [
    "components/**/*.vue",
    "lib/**/*.ts",
    "composables/**/*.ts",
    "snippets/**/*.ts",
    "global-bottom.vue",
    "env.d.ts"
  ]
}
